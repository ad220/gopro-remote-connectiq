project.manifest = manifest.xml

base.sourcePath = source/; include/secrets
base.excludeAnnotations = mobile; lowend; debugoff
base.resourcePath = resources/common; resources/lang/en
base.lang.fre = resources/lang/fre

mobile_exclude = ble; lowend; debugoff

mobile-light_exclude = ble; highend; debugoff

